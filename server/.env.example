# ─── Server ───
PORT=8080
# Comma-separated list of allowed frontend origins (no trailing slash).
CORS_ORIGINS=http://localhost:5173,https://infiniteyatra.com

# ─── MongoDB ───
# Atlas connection string, or a local mongodb://127.0.0.1:27017/infiniteyatra
MONGODB_URI=

# ─── Auth (JWT) ───
# Generate a long random secret, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Email(s) that get the admin role, comma-separated.
ADMIN_EMAILS=chauhanparth165@gmail.com

# ─── Cloudinary (added in Phase 2) ───
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
