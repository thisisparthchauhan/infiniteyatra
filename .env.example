VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID_USER=your_user_template_id_here
VITE_EMAILJS_TEMPLATE_ID_ADMIN=your_admin_template_id_here

# ─── New MongoDB API (migration off Firebase) ───
# Base origin of the Node/Express API (server/). No trailing slash.
VITE_API_URL=http://localhost:8080
# Feature flag: 'true' routes form submissions to the new API instead of
# Firestore. Keep 'false' until the API is deployed and MongoDB is connected.
VITE_USE_API=false

# ─── Package booking API (PB-1, Firebase Functions) ───
# Origin of the Firebase Functions Express app that serves the package booking
# endpoints. This is a DIFFERENT service from VITE_API_URL above: bookings live
# in Firestore and authenticate with Firebase ID tokens, not the MongoDB JWT.
#
# Empty  = same-origin '/api'. Correct only where the reverse proxy or Firebase
#          Hosting rewrite provably reaches the Functions app.
# Local  = leave empty; vite.config.js already proxies /api to the emulator.
# Direct = https://<region>-<project>.cloudfunctions.net/api
#
# Which origin is correct in production is unresolved — see
# IY_PACKAGE_BOOKING_IMPLEMENTATION.md, "Ingress requirement before release".
VITE_BOOKING_API_BASE_URL=
