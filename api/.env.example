# Infinite Yatra API — Hostinger environment template.
# NO VALUES ARE COMMITTED. Fill these in Hostinger's environment settings.

NODE_ENV=production
PORT=3000

# MariaDB (Hostinger managed database)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=10

# Signing/secret material. Generate with:  openssl rand -base64 48
# At least 32 characters; the API refuses to start in production without it.
SESSION_SECRET=
SESSION_TTL_DAYS=30

# Public origins
APP_ORIGIN=https://www.infiniteyatra.com
PUBLIC_APP_URL=https://www.infiniteyatra.com

# Rate limits (defaults shown; raise only with a reason)
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_STAFF_AUTH_MAX=10
RATE_LIMIT_BOOKING_MAX=20
RATE_LIMIT_GLOBAL_MAX=600

# PRIVATE DOCUMENT/PDF STORAGE — leave EMPTY until approved.
#
# Must be an ABSOLUTE path OUTSIDE public_html. Identity documents (passport,
# Aadhaar, PAN) and summary PDFs are written here. If this is empty, or points
# anywhere under public_html, document upload and PDF generation stay disabled
# and the UI does not offer them. That is the intended launch state.
#
#   PRIVATE_STORAGE_DIR=/home/<account>/private/iy-documents
PRIVATE_STORAGE_DIR=

# First-admin bootstrap — used once by scripts/bootstrap-admin.mjs, then removed.
# IY_ADMIN_EMAIL=
# IY_ADMIN_PASSWORD=
