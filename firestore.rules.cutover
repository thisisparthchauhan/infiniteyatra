rules_version = '2';
// ============================================================================
// CUTOVER — FINAL INTENDED RULES. NOT DEPLOYED.
//
// This file is firestore.rules with ONE deliberate change: customers can no
// longer create a booking from the browser. Everything else is identical, so a
// review only has to read the booking block.
//
// DEPLOY ORDER MATTERS. The currently-live frontend still writes bookings
// directly to Firestore. Deploying this file before that frontend is replaced
// stops the live site taking bookings. The safe sequence is:
//
//   1. deploy the PB booking API (Functions)
//   2. deploy the frontend that posts to it
//   3. confirm new bookings are arriving with schemaVersion
//   4. only then deploy THIS ruleset
//
// Until step 4, firestore.rules remains the deployed ruleset and is the
// transitional state: it still permits the legacy client-side create, which is
// exactly what keeps the live site working mid-cutover.
//
// What this preserves: owner reads of the 15 historical bookings. `get, list`
// is unchanged, so legacy records stay visible in My Bookings forever.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {
    // Authorization is based only on server-issued Firebase Auth custom claims.
    // Client profile fields, local UI roles, and email addresses are not security
    // boundaries. Phase 0C will formalize the wider RBAC claim model.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'admin'
      );
    }

    function ownsExistingDocument() {
      return request.auth != null && resource.data.userId == request.auth.uid;
    }

    function ownsNewDocument() {
      return request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /vehicles/{vehicleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /vehicle_cities/{cityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /transport_bookings/{bookingId} {
      // Users can create bookings and read their own bookings. Admin has full read/write.
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /transport_settings/{settingId} {
      // Anyone can read (needed for frontend logic like isTransportEnabled). Admin has full write.
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bookings/{bookingId} {
      // A customer can fetch only their own booking. Collection queries must
      // include a userId == request.auth.uid constraint; rules are not filters.
      allow get, list: if isAdmin() || ownsExistingDocument();

      // CUTOVER - the browser no longer creates bookings.
      //
      // Canonical bookings are written by the PB API through the Admin SDK,
      // which bypasses these rules entirely, so denying the client here costs
      // the server nothing and removes the whole class of problems the old
      // allowlist was holding back: a client choosing its own price, statuses,
      // or `schemaVersion`. Note that `schemaVersion` was never in the legacy
      // allowlist either, so no historical record can claim to be canonical.
      //
      // Stated explicitly rather than left to default-deny so the intent is
      // reviewable, and so a future re-opening of client writes has to be a
      // visible edit here.
      allow create: if false;

      // There is no legitimate direct customer update contract today. Existing
      // client-side cancellation/refund mutations must move behind a trusted
      // server endpoint before they can be enabled safely.
      allow update, delete: if isAdmin();

      // PB-1 booking audit trail. Written exclusively by the Cloud Functions
      // booking API via the Admin SDK, which bypasses these rules entirely;
      // the deny below governs the browser SDK only. It is stated explicitly
      // rather than left to the default-deny so that the intent is reviewable
      // and a future write from the client fails loudly at review time rather
      // than silently at runtime.
      match /activity/{activityId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      // PB-3 traveller document metadata. Written exclusively by the Cloud
      // Functions document API via the Admin SDK, which bypasses these rules;
      // the deny below governs the browser SDK only.
      //
      // Customers read their documents through GET /api/bookings/:id/documents,
      // not directly, because these records carry `storagePath` and the
      // server-owned review fields. Keeping the client out means a customer can
      // never see a storage path, and can never set reviewStatus, reviewedBy or
      // reviewedAt by writing the document themselves.
      match /documents/{documentId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // PB-1 booking reference reservations. The uniqueness guarantee behind
    // IY-BKG-YYYY-XXXXXX: one document per issued reference, created inside the
    // same transaction as the booking. Server-owned; no client access at all.
    match /booking_references/{reference} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // PB-4 Booking Summary metadata.
    //
    // Named `booking_documents` rather than `invoices` deliberately: a Booking
    // Summary is not an invoice, and the programme architecture reserves
    // `invoices/{id}` for the real tax invoice issued once a booking is fully
    // paid. `documentKind` discriminates BOOKING_SUMMARY from the
    // PAYMENT_RECEIPT that PB-6 will add.
    //
    // Server-owned. Customers read their summary through the API, not directly,
    // because these records carry `storagePath` and the issuing state.
    match /booking_documents/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // PB-4 sequential number counters. Closed to every client: the counter is
    // the integrity of the numbering, and reading it would disclose volume.
    match /booking_document_numbers/{counterId} {
      allow read, write: if false;
    }

    // PB-1 idempotency records, keyed by sha256(uid + ':' + idempotencyKey).
    // Server-owned. Client read would leak nothing useful but is denied anyway:
    // nothing outside the booking API has a legitimate reason to see them.
    match /booking_idempotency/{idempotencyId} {
      allow read, write: if false;
    }
    match /users/{userId} {
      // Customer profiles are private and keyed by the Firebase Auth uid.
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow list: if isAdmin();

      // Customers may create only their own non-privileged profile. Email must
      // match the Firebase Auth token identity and is immutable thereafter.
      allow create: if isAdmin() || (
        request.auth != null
        && request.auth.uid == userId
        && request.auth.token.get('email', '') != ''
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasAll(['email', 'createdAt'])
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'createdAt', 'firstName', 'middleName',
          'lastName', 'nickname', 'dateOfBirth', 'gender', 'placeOfBirth',
          'photoURL', 'interests', 'emergencyContacts'
        ])
      );

      // An affected-key allowlist blocks role, isAdmin, uid, credits,
      // travelPoints, passport/referral state, and every other privileged or
      // server-owned field, including fields added in the future.
      allow update: if isAdmin() || (
        request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'phone', 'firstName', 'middleName', 'lastName', 'nickname',
          'dateOfBirth', 'gender', 'placeOfBirth', 'photoURL', 'interests',
          'emergencyContacts'
        ])
      );

      allow delete: if isAdmin();
    }
    match /savedTrips/{tripId} {
      allow read: if resource.data.isPublic == true || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    // ───── Reusable validators ─────
    function isValidEmail(s) {
      // Length-bounded email — Firestore rules regex is limited; we use a loose
      // RFC-5321-style check that catches obvious garbage. Client-side already
      // validates more strictly. Reject anything longer than 254 chars.
      return s is string
          && s.size() > 3
          && s.size() <= 254
          && s.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }
    function isShortString(s, max) {
      return s is string && s.size() <= max;
    }
    function isClientTimestamp(t) {
      // Must be a server timestamp (serverTimestamp()) — rejects client-forged dates.
      return t == request.time;
    }

    match /enquiries/{enquiryId} {
      // Anyone can create an enquiry, but the document must be well-formed.
      allow create: if request.resource.data.size() <= 12  // cap field count
                    && isShortString(request.resource.data.get('name', ''), 200)
                    && isShortString(request.resource.data.get('phone', ''), 40)
                    && isShortString(request.resource.data.get('message', ''), 5000)
                    && (!('email' in request.resource.data) || isValidEmail(request.resource.data.email));
      // SA-1B - was a hardcoded token.email grant. Enquiry records are CRM
      // data; this matches the `leads` collection below, which was already
      // admin-only. Deliberately NOT widened to booking_manager.
      allow read, update, delete: if isAdmin();
    }
    match /leads/{leadId} {
      // Unified lead-capture collection written by every public inquiry form
      // (enquiry popup, contact, hotel inquiry, private jets, partner onboarding,
      // WhatsApp click). Anyone can create a bounded, well-formed lead; clients
      // never list the collection — admin reads it via the dashboard.
      allow create: if request.resource.data.size() <= 25
                    && isShortString(request.resource.data.get('name', ''), 200)
                    && isShortString(request.resource.data.get('phone', ''), 40)
                    && isShortString(request.resource.data.get('message', ''), 5000)
                    && (!('email' in request.resource.data)
                        || request.resource.data.email == ''
                        || isValidEmail(request.resource.data.email));
      allow read, update, delete: if isAdmin();
    }
    match /newsletter_subscribers/{subscriberId} {
      // Anyone can subscribe; require a real email.
      allow create: if request.resource.data.size() <= 6
                    && 'email' in request.resource.data
                    && isValidEmail(request.resource.data.email);
      // SA-1B - was a hardcoded token.email grant. Subscriber addresses are
      // personal data with no scoped-role owner; admin only.
      allow read, update, delete: if isAdmin();
    }

    // ───── Ascension Project — Get Involved signup form ─────
    // Unauthenticated visitors can create a signup, but the write has to pass
    // shape + content validation. Reads/updates/deletes are admin-only via the
    // Firebase Console — clients never list this collection.
    match /ascension_signups/{signupId} {
      allow create: if
           // Document must have exactly the expected keys — no extra fields
           // (no client trying to inject `verified: true` etc).
           request.resource.data.keys().hasOnly(['email','intent','source','userAgent','msToSubmit','createdAt'])
           && request.resource.data.keys().hasAll(['email','intent','source','createdAt'])
           // Email
           && isValidEmail(request.resource.data.email)
           // Intent must be one of the three allowed verbs
           && request.resource.data.intent in ['subscribe','contribute','apply']
           // Source pinned — clients can't forge as if they came from another page
           && request.resource.data.source == 'ascension-project'
           // UserAgent optional, bounded length
           && (!('userAgent' in request.resource.data) || isShortString(request.resource.data.userAgent, 1000))
           // msToSubmit optional, must be a non-negative number capped at 10 min
           && (!('msToSubmit' in request.resource.data) || (request.resource.data.msToSubmit is number && request.resource.data.msToSubmit >= 0 && request.resource.data.msToSubmit <= 600000))
           // createdAt must be a server timestamp — rejects clients forging
           // arbitrary dates
           && isClientTimestamp(request.resource.data.createdAt);
      // No client-side reads, updates, or deletes. Admin reads via Console.
      allow read, update, delete: if false;
    }
    match /packages/{packageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /reviews/{reviewId} {
      // Anyone can read reviews (package pages show approved ones; admin reads all)
      allow read: if true;
      // Logged-in users can submit their own review
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Only admin can approve / reject / edit / delete
      allow update, delete: if isAdmin();
    }
    match /hotels/{hotelId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /travelStories/{storyId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      // SA-1B - authors still manage their own story. Moderation of anyone
      // else's was a hardcoded token.email grant and is now the admin claim.
      // `content_manager` owns "stories" in the role catalogue but is wired to
      // no rule, route or guard and is held by no account, so granting it here
      // would widen access rather than preserve it. Left to a scoped-content task.
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.authorId == request.auth.uid);
    }
  }
}
