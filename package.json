{
  "name": "infiniteyatra",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:local": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "security:secrets": "bash scripts/scan-secrets.sh",
    "test:firestore-rules": "firebase emulators:exec --project demo-infinite-yatra-rules --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "test:sa1": "node --test tests/sa1.staff-auth.test.mjs",
    "test:pb4-rules": "firebase emulators:exec --project demo-infinite-yatra-pb4 --only firestore,storage \"node --test tests/pb4.rules.test.mjs\"",
    "test:pb4": "firebase emulators:exec --project demo-infinite-yatra-pb4 --only firestore,auth,storage \"node --test functions/test/emulator/packageBookingSummary.test.js\"",
    "test:pb3": "firebase emulators:exec --project demo-infinite-yatra-pb3 --only firestore,auth,storage \"node --test functions/test/emulator/packageBookingDocuments.test.js\"",
    "test:pb3-storage": "firebase emulators:exec --project demo-infinite-yatra-pb3 --only storage \"node --test tests/pb3.storage.rules.test.mjs\"",
    "test:pb2": "node --test tests/pb2.booking-cutover.test.mjs",
    "test:pb1-rules": "firebase emulators:exec --project demo-infinite-yatra-pb1 --only firestore \"node --test tests/pb1.rules.test.mjs\"",
    "test:emulator": "firebase emulators:exec --project demo-infinite-yatra-pb1 --only firestore,auth \"node --test functions/test/emulator/packageBookingEmulator.test.js\"",
    "test:p0-05": "node --test tests/p0-05.false-invoice.test.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "deploy": "vite build && firebase deploy"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@google/generative-ai": "^0.24.1",
    "@tailwindcss/vite": "^4.1.17",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "firebase": "^12.6.0",
    "framer-motion": "^11.18.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.554.0",
    "openai": "^6.32.0",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hot-toast": "^2.6.0",
    "react-phone-input-2": "^2.15.1",
    "react-router-dom": "^7.9.6",
    "react-simple-maps": "^3.0.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "vite": "^7.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.58.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-security": "^1.7.1",
    "globals": "^16.5.0"
  }
}
