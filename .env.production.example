# Copy to .env.production for production builds (`npm run build`).
# Vite loads this automatically in production mode.

# Empty = same-origin: Nginx proxies /api on the VPS to the Node app, so the
# browser calls https://infiniteyatra.com/api/... with no CORS.
VITE_API_URL=

# Route form submissions to the new MongoDB API (Phase 2+).
VITE_USE_API=true
